---
import Base from '../layouts/Base.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { site } from '../data/site.js';
---
<Base title="Get a free lawn quote" description={`Request a free lawn mowing, cleanup or pine straw quote from ${site.name} in ${site.city}, ${site.region}.`} path="/quote/">
  <section class="sec sec--quote">
    <div class="wrap split">
      <div class="sec__head">
        <p class="eyebrow">Free quote · {site.city}, {site.region}</p>
        <h1>Tell us about the yard. We'll tell you what it costs.</h1>
        <p class="lede">Rather talk it through? Call <a href={`tel:${site.phoneHref}`}><strong>{site.phoneDisplay}</strong></a>.</p>
        <a class="rating" href={site.gbp} rel="noopener"><b>★★★★★</b> {site.rating} from {site.reviews} Google reviews</a>
      </div>
      <QuoteForm heading="Your free quote" />
    </div>
  </section>
</Base>
