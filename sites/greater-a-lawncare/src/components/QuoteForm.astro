---
// Multi-step quote request. DEMO ONLY: it validates and shows a success state
// but sends nothing, because this preview is not operated by the business.
import { site, services } from '../data/site.js';
const { preselect = '', heading = 'Get a free lawn quote', id = 'quote' } = Astro.props;
const jobs = [
  ...services.map((s) => [s.slug, s.job]),
  ['overgrown', 'Overgrown lot'],
  ['other', 'Something else'],
];
const sizes = ['Small city lot', 'Average yard', 'Big yard', 'Acre or more'];
const often = ['Every week', 'Every 2 weeks', 'Just once'];
const back = ['Open', 'Gated', 'Gated, with a dog'];
---
<section class="quote" id={id}>
  <div class="quote__head">
    <h2>{heading}</h2>
    <p>Three quick taps and your details. Works one-handed, standing in the yard.</p>
  </div>
  <form class="qf" data-quote novalidate>
    <ol class="qf__steps" aria-hidden="true"><li class="is-on"><b>1</b> Yard work</li><li><b>2</b> Your yard</li><li><b>3</b> Contact</li></ol>

    <fieldset class="qf__panel is-on" data-step="0">
      <legend>What does your yard need?</legend>
      <div class="chips">
        {jobs.map(([v, l]) => (
          <label class="chip"><input type="checkbox" name="job" value={l} checked={v === preselect} /><span>{l}</span></label>
        ))}
      </div>
      <p class="qf__err" data-err hidden>Pick at least one so the quote covers the right work.</p>
      <div class="qf__nav"><button class="btn" type="button" data-next>Next: your yard</button></div>
    </fieldset>

    <fieldset class="qf__panel" data-step="1">
      <legend>Tell us about the yard</legend>
      <div class="seg" role="group" aria-label="Yard size">
        <span class="seg__l">Size</span>
        {sizes.map((v, i) => <label><input type="radio" name="size" value={v} checked={i === 1} /><span>{v}</span></label>)}
      </div>
      <div class="seg" role="group" aria-label="How often">
        <span class="seg__l">How often</span>
        {often.map((v, i) => <label><input type="radio" name="often" value={v} checked={i === 1} /><span>{v}</span></label>)}
      </div>
      <div class="seg" role="group" aria-label="Back yard access">
        <span class="seg__l">Back yard</span>
        {back.map((v, i) => <label><input type="radio" name="back" value={v} checked={i === 0} /><span>{v}</span></label>)}
      </div>
      <div class="qf__nav">
        <button class="btn btn--ghost" type="button" data-back>Back</button>
        <button class="btn" type="button" data-next>Next: your details</button>
      </div>
    </fieldset>

    <fieldset class="qf__panel" data-step="2">
      <legend>Where should the quote go?</legend>
      <p class="qf__sum" data-summary></p>
      <div class="fields">
        <label>Name<input name="name" autocomplete="name" required /></label>
        <label>Phone<input name="phone" type="tel" inputmode="tel" autocomplete="tel" required pattern="[0-9+() .-]{7,}" /></label>
        <label class="wide">Street or neighbourhood <small>(optional)</small><input name="street" autocomplete="street-address" /></label>
        <label class="wide">Anything else? <small>(optional)</small><textarea name="notes" rows="2" placeholder="Steep bank out back, gate code, best time to call…"></textarea></label>
      </div>
      <p class="qf__err" data-err hidden>Please add your name and a phone number to reach you on.</p>
      <div class="qf__nav">
        <button class="btn btn--ghost" type="button" data-back>Back</button>
        <button class="btn" type="submit">Send my request</button>
      </div>
    </fieldset>

    <div class="qf__done" data-done hidden tabindex="-1">
      <svg viewBox="0 0 48 48" width="52" height="52" aria-hidden="true"><circle cx="24" cy="24" r="22" fill="#b7d84b"/><path d="M14 24.5l7 7 13-14" fill="none" stroke="#18301f" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <h3>That is how easy it would be.</h3>
      <p data-done-sum></p>
      <p class="qf__demo">This is a concept preview, so nothing was sent. On the live site this request would go straight to {site.short} the moment you press send.</p>
      <a class="btn btn--ghost" href={`tel:${site.phoneHref}`}>Call {site.phoneDisplay} instead</a>
    </div>
  </form>
</section>
<script>
  document.querySelectorAll('[data-quote]').forEach((form) => {
    const panels = [...form.querySelectorAll('[data-step]')];
    const dots = [...form.querySelectorAll('.qf__steps li')];
    let step = 0;
    const jobs = () => [...form.querySelectorAll('input[name=job]:checked')].map((i) => i.value);
    const summary = () => {
      const d = new FormData(form);
      return `${jobs().join(', ')} · ${String(d.get('size')).toLowerCase()} · ${String(d.get('often')).toLowerCase()} · back yard ${String(d.get('back')).toLowerCase()}`;
    };
    function show(n) {
      step = n;
      panels.forEach((p, i) => p.classList.toggle('is-on', i === n));
      dots.forEach((d, i) => { d.classList.toggle('is-on', i === n); d.classList.toggle('is-past', i < n); });
      if (n === 2) form.querySelector('[data-summary]').textContent = summary();
      panels[n].querySelector('legend')?.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    }
    function valid(n) {
      const err = panels[n].querySelector('[data-err]');
      let ok = true;
      if (n === 0) ok = jobs().length > 0;
      if (n === 2) ok = [...panels[2].querySelectorAll('input[required]')].every((i) => i.checkValidity());
      if (err) err.hidden = ok;
      return ok;
    }
    form.addEventListener('click', (e) => {
      if (e.target.closest('[data-next]') && valid(step)) show(step + 1);
      if (e.target.closest('[data-back]')) show(step - 1);
    });
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!valid(2)) return;
      const name = String(new FormData(form).get('name')).trim().split(' ')[0];
      panels.forEach((p) => p.classList.remove('is-on'));
      form.querySelector('.qf__steps').hidden = true;
      const done = form.querySelector('[data-done]');
      form.querySelector('[data-done-sum]').textContent = `Thanks, ${name}. Your request: ${summary()}.`;
      done.hidden = false; done.focus();
    });
  });
</script>
