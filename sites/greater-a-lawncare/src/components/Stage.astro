---
// Lazy 3D stage. The canvas only boots after the page has loaded, so it never
// competes with first paint. Until then (and if WebGL is missing) the CSS
// poster behind it is what people see.
const { surface = 'mow', mode = 'auto', track = '', label = '3D model', class: cls = '', hint = ['Move across the lawn to mow it yourself', 'Swipe across the lawn to mow it'] } = Astro.props;
---
<div class={`stage ${cls}`} data-stage data-surface={surface} data-mode={mode} data-track={track}>
  <canvas role="img" aria-label={label}></canvas>
  <p class="stage__hint" data-hint aria-hidden="true">
    <span class="fine">{hint[0]}</span>
    <span class="coarse">{hint[1]}</span>
  </p>
</div>
<script>
  const stages = document.querySelectorAll('[data-stage]');
  if (stages.length) {
    const boot = () => import('../scenes/lawn.js').then((m) => stages.forEach((el) => m.mount(el))).catch(() => {});
    const start = () => ('requestIdleCallback' in window ? requestIdleCallback(boot, { timeout: 1200 }) : setTimeout(boot, 150));
    if (document.readyState === 'complete') start(); else addEventListener('load', start, { once: true });
  }
</script>
