---
import { site, services } from '../data/site.js';
const { path = '/' } = Astro.props;
---
<header class="top">
  <a class="brand" href="/" aria-label={`${site.name} home`}>
    <svg viewBox="0 0 32 32" width="36" height="36" aria-hidden="true"><rect width="32" height="32" rx="3" fill="currentColor"/><path d="M20 9.5V6.5h3.4v6" fill="#a33d26"/><path d="M4.5 19 16 8.5 27.5 19" fill="none" stroke="#f1ece3" stroke-width="3" stroke-linecap="square"/><path d="M8 24h16" stroke="#8b949a" stroke-width="2.4"/></svg>
    <span><b>{site.short}</b><i>{site.tagline}</i></span>
  </a>
  <nav class="nav" id="nav" aria-label="Main">
    {services.map((s) => (
      <a href={`/services/${s.slug}/`} aria-current={path === `/services/${s.slug}/` ? 'page' : undefined}>{s.name}</a>
    ))}
    <a href="/#reviews">Reviews</a>
    <a class="btn btn--sm" href="/quote/">Free quote</a>
  </nav>
  <a class="top__call" href={`tel:${site.phoneHref}`}><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6.6 10.8a15.5 15.5 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z" fill="currentColor"/></svg>{site.phoneDisplay}</a>
  <button class="menu" type="button" aria-controls="nav" aria-expanded="false"><span></span><span></span><span></span><i class="sr">Menu</i></button>
</header>
<script>
  const btn = document.querySelector('.menu'), nav = document.getElementById('nav');
  btn?.addEventListener('click', () => {
    const open = nav.classList.toggle('is-open');
    btn.setAttribute('aria-expanded', String(open));
  });
  nav?.addEventListener('click', (e) => { if (e.target.closest('a')) { nav.classList.remove('is-open'); btn.setAttribute('aria-expanded', 'false'); } });
</script>
