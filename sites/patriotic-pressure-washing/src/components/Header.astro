---
import { site, services } from '../data/site.js';
const { path = '/' } = Astro.props;
---
<header class="top">
  <a class="brand" href="/" aria-label={`${site.name} home`}>
    <svg viewBox="0 0 40 40" width="38" height="38" aria-hidden="true">
      <rect x="1.5" y="1.5" width="37" height="37" fill="none" stroke="currentColor" stroke-width="2"/>
      <path d="M20 7.5l3.2 6.600 7.300 1-5.300 5.100 1.300 7.200L20 24l-6.500 3.400 1.300-7.200-5.300-5.100 7.300-1z" fill="var(--brick)"/>
      <path d="M7 31.500h26M7 35h26" stroke="currentColor" stroke-width="2"/>
    </svg>
    <span><b>Patriotic</b><i>Pressure Washing</i></span>
  </a>
  <nav class="nav" id="nav" aria-label="Main">
    {services.map((s) => (
      <a href={`/services/${s.slug}/`} aria-current={path === `/services/${s.slug}/` ? 'page' : undefined}>{s.nav}</a>
    ))}
    <a href="/#reviews">Reviews</a>
    <a class="btn btn--sm" href="/quote/">Free estimate</a>
  </nav>
  <a class="top__call" href={`tel:${site.phoneHref}`}>{site.phoneDisplay}</a>
  <button class="menu" type="button" aria-controls="nav" aria-expanded="false"><span></span><span></span><i class="sr">Menu</i></button>
</header>
<script>
  const btn = document.querySelector('.menu'), nav = document.getElementById('nav');
  btn?.addEventListener('click', () => {
    const open = nav.classList.toggle('is-open');
    btn.setAttribute('aria-expanded', String(open));
  });
  nav?.addEventListener('click', (e) => { if (e.target.closest('a')) { nav.classList.remove('is-open'); btn.setAttribute('aria-expanded', 'false'); } });
</script>
