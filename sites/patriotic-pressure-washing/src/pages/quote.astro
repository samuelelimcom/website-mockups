---
import Base from '../layouts/Base.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { site } from '../data/site.js';
---
<Base title="Free estimate" description={`Request a free pressure washing estimate from ${site.name} in ${site.city}, ${site.region}.`} path="/quote/">
  <section class="sec">
    <div class="wrap split">
      <div class="sec__head">
        <p class="eyebrow">Free estimate · {site.city}, {site.region}</p>
        <h1>Tell us what has gone gray. We will tell you what it costs.</h1>
        <p class="lede">Rather talk it through? Call <a href={`tel:${site.phoneHref}`}><strong>{site.phoneDisplay}</strong></a>.</p>
        <a class="rating" href={site.gbp} rel="noopener"><b aria-hidden="true">★</b> {site.rating} on Google · {site.reviews} reviews</a>
      </div>
      <QuoteForm heading="Your free estimate" />
    </div>
  </section>
</Base>
