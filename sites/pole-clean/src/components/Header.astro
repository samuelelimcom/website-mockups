---
import { site, services } from '../data/site.js';
const { path = '/' } = Astro.props;
---
<header class="top">
  <a class="brand" href="/" aria-label={`${site.name} home`}>
    <svg viewBox="0 0 34 34" width="32" height="32" aria-hidden="true"><rect x="5" y="4" width="22" height="26" rx="2.5" fill="none" stroke="currentColor" stroke-width="2.6"/><path d="M16 4v26M5 17h22" stroke="currentColor" stroke-width="2.2"/><path d="M9 12.5l3.5-3.5M19.5 25l3.5-3.5" stroke="#2f7fa8" stroke-width="2.2" stroke-linecap="round"/><path d="M30 33 24 22" stroke="#8e3b26" stroke-width="2.6" stroke-linecap="round"/></svg>
    <span><b>{site.short}</b><i>{site.tagline} · {site.city}</i></span>
  </a>
  <nav class="nav" id="nav" aria-label="Main">
    {services.map((s) => (
      <a href={`/services/${s.slug}/`} aria-current={path === `/services/${s.slug}/` ? 'page' : undefined}>{s.name}</a>
    ))}
    <a href="/#reviews">Reviews</a>
    <a class="btn btn--sm" href="/quote/">Free quote</a>
  </nav>
  <a class="top__call" href={`tel:${site.phoneHref}`}><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6.6 10.8a15.2 15.2 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1z" fill="currentColor"/></svg>{site.phoneDisplay}</a>
  <button class="menu" type="button" aria-controls="nav" aria-expanded="false"><span></span><span></span><i class="sr">Menu</i></button>
</header>
<script>
  const btn = document.querySelector('.menu'), nav = document.getElementById('nav');
  btn?.addEventListener('click', () => {
    const open = nav.classList.toggle('is-open');
    btn.setAttribute('aria-expanded', String(open));
  });
  nav?.addEventListener('click', (e) => { if (e.target.closest('a')) { nav.classList.remove('is-open'); btn.setAttribute('aria-expanded', 'false'); } });
</script>
