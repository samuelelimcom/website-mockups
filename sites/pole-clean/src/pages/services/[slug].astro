---
import Base from '../../layouts/Base.astro';
import Stage from '../../components/Stage.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import { site, services } from '../../data/site.js';
export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props;
const others = services.filter((o) => o.slug !== s.slug);
const labels = {
  glass: 'A 3D red-brick wall with a grimy uPVC window. A water-fed pole brush scrubs the glass and pure water rinses it clear.',
  frames: 'A 3D red-brick wall with a white uPVC window whose frame and sill are green and grey with grime. A pole brush scrubs them back to white.',
  fascia: 'A 3D roofline of a red-brick house with a streaked white fascia board and gutter. A pole brush cleans along the run.',
};
---
<Base title={`${s.name} in ${site.city}`} description={s.short} path={`/services/${s.slug}/`}>
  <div class="wrap shero">
    <div class="shero__text">
      <p class="eyebrow">{s.name} · {site.city}</p>
      <h1>{s.headline}</h1>
      <p class="lede">{s.lede}</p>
      <div class="actions">
        <a class="btn" href="#quote">Get a free quote</a>
        <a class="btn btn--ghost" href={`tel:${site.phoneHref}`}>Call {site.phoneDisplay}</a>
      </div>
      <a class="rating" href="/#reviews"><b>★★★★★</b> {site.rating} from {site.reviews} Google reviews</a>
    </div>
    <Stage surface={s.surface} mode="auto" hint={s.hint} label={labels[s.surface]} />
  </div>

  <section class="sec">
    <div class="wrap">
      <div class="sec__head"><p class="eyebrow">What's included</p><h2>What this job usually covers.</h2></div>
      <div class="grid grid--3">
        {s.what.map(([t, d], i) => <div class="tile"><span class="tile__n">0{i + 1}</span><h3>{t}</h3><p>{d}</p></div>)}
      </div>
    </div>
  </section>

  <section class="sec band">
    <div class="wrap">
      <div class="sec__head"><p class="eyebrow">How it's done</p><h2>Three steps, top to bottom.</h2></div>
      <ol class="steps">{s.steps.map(([t, d]) => <li><h3>{t}</h3><p>{d}</p></li>)}</ol>
    </div>
  </section>

  <section class="sec">
    <div class="wrap split">
      <div>
        <div class="sec__head"><p class="eyebrow">Good to know</p><h2>Questions people ask first.</h2></div>
        <div class="faq">
          {s.faqs.map(([q, a], i) => <details open={i === 0}><summary>{q}</summary><p>{a}</p></details>)}
        </div>
      </div>
      <QuoteForm preselect={s.slug} heading={`Quote for ${s.job.toLowerCase()}`} />
    </div>
  </section>

  <section class="sec band">
    <div class="wrap">
      <div class="sec__head"><p class="eyebrow">While the pole is out</p><h2>Often done on the same visit.</h2></div>
      <div class="svcs svcs--2">
        {others.map((o) => (
          <a class="svc" href={`/services/${o.slug}/`}>
            <div class={`pane pane--${o.surface}`}></div>
            <div class="svc__body"><span class="tag">{o.kicker}</span><h3>{o.name}</h3><p>{o.short}</p><span class="svc__go">How it's done →</span></div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
