---
// Multi-step estimate request. DEMO ONLY: it validates and shows a success state
// but sends nothing, because this preview is not operated by the business.
import { site, services, extraJobs } from '../data/site.js';
const { preselect = '', heading = 'Get a free estimate', id = 'quote' } = Astro.props;
const jobs = [...services.map((s) => [s.job, s.name]), ...extraJobs];
const near = ['House or roof', 'Power lines', 'Fence', 'Driveway', 'Open yard'];
---
<section class="quote" id={id}>
  <div class="quote__head">
    <h2>{heading}</h2>
    <p>Describe the tree in three quick steps. No obligation.</p>
  </div>
  <form class="qf" data-quote novalidate>
    <ol class="qf__steps" aria-hidden="true"><li class="is-on">The job</li><li>The tree</li><li>You</li></ol>

    <fieldset class="qf__panel is-on" data-step="0">
      <legend>What do you need?</legend>
      <div class="chips">
        {jobs.map(([v, l]) => (
          <label class="chip"><input type="checkbox" name="job" value={l} checked={v === preselect} /><span>{l}</span></label>
        ))}
      </div>
      <p class="qf__err" data-err hidden>Pick at least one so the estimate covers the right job.</p>
      <div class="qf__nav"><button class="btn" type="button" data-next>Next: the tree</button></div>
    </fieldset>

    <fieldset class="qf__panel" data-step="1">
      <legend>Tell us about the tree</legend>
      <div class="seg" role="group" aria-label="Height">
        <span class="seg__l">How tall?</span>
        {['Under 20 ft', '20 to 40 ft', 'Over 40 ft', 'Not sure'].map((v, i) => (
          <label><input type="radio" name="height" value={v} checked={i === 1} /><span>{v}</span></label>
        ))}
      </div>
      <div class="seg" role="group" aria-label="What is near it">
        <span class="seg__l">What is close to it?</span>
        {near.map((v, i) => (
          <label class="chip"><input type="checkbox" name="near" value={v} checked={i === 0} /><span>{v}</span></label>
        ))}
      </div>
      <label class="range">
        <span>How many trees or stumps? <output data-size-out>1</output></span>
        <input type="range" name="count" min="1" max="10" step="1" value="1" data-size />
      </label>
      <div class="seg" role="group" aria-label="Timing">
        <span class="seg__l">How soon?</span>
        {['It is urgent', 'In the next few weeks', 'Just planning'].map((v, i) => (
          <label><input type="radio" name="when" value={v} checked={i === 1} /><span>{v}</span></label>
        ))}
      </div>
      <div class="qf__nav">
        <button class="btn btn--ghost" type="button" data-back>Back</button>
        <button class="btn" type="button" data-next>Next: your details</button>
      </div>
    </fieldset>

    <fieldset class="qf__panel" data-step="2">
      <legend>Where should the estimate go?</legend>
      <p class="qf__sum" data-summary></p>
      <div class="fields">
        <label>Name<input name="name" autocomplete="name" required /></label>
        <label>Phone<input name="phone" type="tel" inputmode="tel" autocomplete="tel" required pattern="[0-9+() .-]{7,}" /></label>
        <label class="wide">Street or area <small>(optional)</small><input name="street" autocomplete="address-line1" /></label>
        <label class="wide">Anything else? <small>(optional: gate width, which tree, best time to call)</small><textarea name="notes" rows="2"></textarea></label>
      </div>
      <p class="qf__err" data-err hidden>Please add your name and a phone number to call you back on.</p>
      <div class="qf__nav">
        <button class="btn btn--ghost" type="button" data-back>Back</button>
        <button class="btn" type="submit">Send my request</button>
      </div>
    </fieldset>

    <div class="qf__done" data-done hidden tabindex="-1">
      <svg viewBox="0 0 48 48" width="52" height="52" aria-hidden="true"><circle cx="24" cy="24" r="22" fill="#f26a1b"/><path d="M14 24.500l7 7 13-14" fill="none" stroke="#1b241c" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <h3>That is all it would take.</h3>
      <p data-done-sum></p>
      <p class="qf__demo">This is a concept preview, so nothing was sent. On the live site this request would go straight to {site.short} the moment you press send.</p>
      <a class="btn btn--ghost" href={`tel:${site.phoneHref}`}>Call {site.phoneDisplay} instead</a>
    </div>
  </form>
</section>
<script>
  document.querySelectorAll('[data-quote]').forEach((form) => {
    const panels = [...form.querySelectorAll('[data-step]')];
    const dots = [...form.querySelectorAll('.qf__steps li')];
    const size = form.querySelector('[data-size]'), out = form.querySelector('[data-size-out]');
    const fmt = (n) => (Number(n) >= 10 ? '10 or more' : String(n));
    let step = 0;
    const picked = (n) => [...form.querySelectorAll(`input[name=${n}]:checked`)].map((i) => i.value);
    const summary = () => {
      const d = new FormData(form), n = Number(d.get('count'));
      const near = picked('near');
      return `${picked('job').join(', ')} · ${fmt(n)} ${n === 1 ? 'tree' : 'trees'}, ${String(d.get('height')).toLowerCase()}${near.length ? ` · near ${near.join(', ').toLowerCase()}` : ''} · ${String(d.get('when')).toLowerCase()}`;
    };
    function show(n) {
      step = n;
      panels.forEach((p, i) => p.classList.toggle('is-on', i === n));
      dots.forEach((d, i) => { d.classList.toggle('is-on', i === n); d.classList.toggle('is-past', i < n); });
      if (n === 2) form.querySelector('[data-summary]').textContent = summary();
      panels[n].querySelector('legend')?.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    }
    function valid(n) {
      const err = panels[n].querySelector('[data-err]');
      let ok = true;
      if (n === 0) ok = picked('job').length > 0;
      if (n === 2) ok = [...panels[2].querySelectorAll('input[required]')].every((i) => i.checkValidity());
      if (err) err.hidden = ok;
      return ok;
    }
    size.addEventListener('input', () => { out.textContent = fmt(size.value); size.style.setProperty('--p', ((size.value - size.min) / (size.max - size.min)) * 100 + '%'); });
    size.dispatchEvent(new Event('input'));
    form.addEventListener('click', (e) => {
      if (e.target.closest('[data-next]') && valid(step)) show(step + 1);
      if (e.target.closest('[data-back]')) show(step - 1);
    });
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!valid(2)) return;
      const name = String(new FormData(form).get('name')).trim().split(' ')[0];
      panels.forEach((p) => p.classList.remove('is-on'));
      form.querySelector('.qf__steps').hidden = true;
      const done = form.querySelector('[data-done]');
      form.querySelector('[data-done-sum]').textContent = `Thanks, ${name}. Your request: ${summary()}.`;
      done.hidden = false; done.focus();
    });
  });
</script>
