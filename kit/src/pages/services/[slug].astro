---
import Base from '../../layouts/Base.astro';
import Stage from '../../components/Stage.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import { site, services } from '../../data/site.js';
export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props;
const pre = { siding: 'house', concrete: 'driveway', roof: 'roof' }[s.surface];
const others = services.filter((o) => o.slug !== s.slug);
---
<Base title={`${s.name} in ${site.city}, ${site.region}`} description={s.short} path={`/services/${s.slug}/`}>
  <div class="wrap shero">
    <div class="shero__text">
      <p class="eyebrow">{s.kicker} · {site.city}, {site.region}</p>
      <h1>{s.headline}</h1>
      <p class="lede">{s.lede}</p>
      <div class="actions">
        <a class="btn" href="#quote">Quote my {pre === 'house' ? 'house' : pre}</a>
        <a class="btn btn--ghost" href={`tel:${site.phoneHref}`}>Call {site.phoneDisplay}</a>
      </div>
      <a class="rating" href="/#reviews"><b>★★★★★</b> {site.rating} from {site.reviews} Google reviews</a>
    </div>
    <Stage surface={s.surface} mode="auto" label={`A 3D sample of ${s.name.toLowerCase()} being washed clean`} />
  </div>

  <section class="sec">
    <div class="wrap">
      <div class="sec__head"><p class="eyebrow">What is on it</p><h2>Know what you are looking at.</h2></div>
      <div class="grid grid--3">
        {s.what.map(([t, d]) => <div class="tile"><h3>{t}</h3><p>{d}</p></div>)}
      </div>
    </div>
  </section>

  <section class="sec band">
    <div class="wrap">
      <div class="sec__head"><p class="eyebrow">How it is done</p><h2>Three steps, done in the right order.</h2></div>
      <ol class="steps">{s.steps.map(([t, d]) => <li><h3>{t}</h3><p>{d}</p></li>)}</ol>
    </div>
  </section>

  <section class="sec">
    <div class="wrap split">
      <div>
        <div class="sec__head"><p class="eyebrow">Good to know</p><h2>Questions people ask first.</h2></div>
        <div class="faq">
          {s.faqs.map(([q, a], i) => <details open={i === 0}><summary>{q}</summary><p>{a}</p></details>)}
        </div>
      </div>
      <QuoteForm preselect={pre} heading={`Quote my ${pre === 'house' ? 'house wash' : pre === 'driveway' ? 'driveway' : 'roof wash'}`} />
    </div>
  </section>

  <section class="sec band">
    <div class="wrap">
      <div class="sec__head"><p class="eyebrow">While we are there</p><h2>Most people add one of these.</h2></div>
      <div class="grid grid--2">
        {others.map((o) => (
          <a class="tile svc" href={`/services/${o.slug}/`}>
            <div class={`swatch swatch--${o.surface}`}></div>
            <div class="svc__body"><span class="tag">{o.kicker}</span><h3>{o.name}</h3><p>{o.short}</p><span class="svc__go">See how it works →</span></div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
